  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "customer_id arrives as runtime context, never from chat",
        "Server binds the thread, then the loop alternates model and tool calls",
        "Tools: search_catalog · list_my_purchases · get_my_invoice · create_support_request",
        "External: OpenAI gpt-5.6, LangSmith cloud for traces and evals"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Model never sees or sets a customer_id; no model-authored SQL",
        "Thread bound to one customer; mismatch raises PermissionError before the model runs",
        "Missing and foreign invoices return identical responses — no existence oracle"
      ]
    },
    {
      "dot": "amber",
      "title": "Middleware, in execution order",
      "items": [
        "CustomerBoundary — revalidates on before_agent, wrap_model_call, wrap_tool_call",
        "ModelCallLimit 8/run · 40/thread, then ToolCallLimit 12/run · 60/thread",
        "ToolError sanitizes data errors; PermissionError is left to fail closed",
        "HumanInTheLoop interrupts create_support_request; approval routes it to the assigned rep"
      ]
    }
  ]
